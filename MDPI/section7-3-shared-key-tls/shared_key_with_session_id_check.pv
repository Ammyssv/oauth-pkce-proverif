(* shared_key_with_session_id_check.pv
   Earlier model with a shared-key TLS abstraction (Section 7.3; Table 5).
   TLS is modeled by one symmetric key tlsKey, shared by the legitimate client and the
   authorization server and unknown to the attacker. The token request carries the
   client session identifier, the server checks it, and the client accepts only a
   token response for its own session.
   Differences from main.pv (this is the earlier version of the model):
   - the used-code check is done before the PKCE check;
   - the code is not bound to redirect_uri;
   - there are no request identifiers, so S5, B1 and B2 are not included.
   Expected results: Q5 and Q6 (earlier form, "the attacker receives any response")
   are false by construction, because the attacker always receives some response,
   such as an error; all other security queries are true. *)

set preciseActions = true.

(* ==== CRYPTOGRAPHIC PRIMITIVES ==== *)

fun sha256(bitstring): bitstring.
fun base64url(bitstring): bitstring.

fun s256(bitstring): bitstring.
equation forall x: bitstring; s256(x) = base64url(sha256(x)).

fun senc(bitstring, bitstring): bitstring.
reduc forall m: bitstring, k: bitstring; sdec(senc(m, k), k) = m.

fun sign(bitstring, bitstring): bitstring.
fun pk(bitstring): bitstring.
reduc forall m: bitstring, sk: bitstring; verify(sign(m, sk), pk(sk)) = m.

fun mac(bitstring, bitstring): bitstring.
reduc forall m: bitstring, k: bitstring; verify_mac(mac(m, k), m, k) = true.

(* ==== COUNTER ==== *)
type counter.
const c0: counter.
const c1: counter.
fun succ(counter): counter.
equation succ(c0) = c1.

(* ==== TIMESTAMP ==== *)
type timestamp.
const t0: timestamp.
const t1: timestamp.

(* ==== CHANNELS ==== *)
free c: channel.
free browser: channel [private].

(* ==== CONSTANTS ==== *)
const GRANT_TYPE_AUTH_CODE: bitstring.
const CODE_CHALLENGE_METHOD_S256: bitstring.
const INVALID_GRANT: bitstring.
const INVALID_REQUEST: bitstring.
const TOKEN_RESPONSE: bitstring.

(* ==== TABLE ==== *)
table UsedAuthCodes(bitstring, counter, bitstring).

(* ==== EVENTS ==== *)
event UserAuthenticated(bitstring).
event AuthCodeIssued(bitstring).
event ClientSentTokenRequest(bitstring).
event MACVerified(bitstring).
event SignatureVerified(bitstring).
event CodeExchangeInitiated(bitstring).
event CounterValidated(bitstring, counter).
event ReplayDetectedAndBlocked(bitstring).
event CounterIncremented(counter, counter).
event CounterUsedInOrder(counter).
event AuthCodeBindingVerified(bitstring, bitstring).
event PKCEChallengeVerified(bitstring).
event CodeUsedSuccessfully(bitstring, counter).
event AccessTokenIssued(bitstring, bitstring, bitstring).
event TamperedMessageDetected(bitstring).
event InjectionAttemptBlocked(bitstring).

(* Begin events for placement comparison *)
event BeginBeforeSignature(bitstring).      (* P1 *)
event BeginAfterReplayCheck(bitstring).     (* P3 *)

(* Sent event: fired by legitimate and malicious clients *)
event TokenRequestSent(bitstring).

(* Malicious client events *)
event AttackerInterceptedAuthCode(bitstring).
event AttackerAttemptedToUseCode(bitstring).
event AttackerReceivedResponse(bitstring).

(* Real token issued for a code *)
event TokenIssuedFor(bitstring, bitstring).

(* One event per redemption, with a fresh value (used in Q-SU) *)
event Redeemed(bitstring, bitstring).

(* Atomicity assumption (not a verified property): the server checks and records
   a used code in UsedAuthCodes atomically, e.g. with a unique constraint in a
   database or an atomic compare-and-swap. The restriction excludes every trace
   in which the same code is recorded twice. *)
event Stored(bitstring, bitstring).
restriction x: bitstring, s1: bitstring, s2: bitstring;
      event(Stored(x, s1)) && event(Stored(x, s2)) ==> s1 = s2.

(* Client-side token handling *)
event ClientReceivedTokenResponse(bitstring).
event ClientAcceptedToken(bitstring).
event ClientRejectedToken(bitstring).

event ClientStartedS(bitstring).
event AuthCodeIssuedForS(bitstring, bitstring).
event TokenIssuedForS(bitstring, bitstring, bitstring).
event ClientAcceptedTokenS(bitstring, bitstring, bitstring).

(* ==== SECURITY QUERIES ==== *)

query attacker(new authCode).
query attacker(new accessToken).
query attacker(new codeVerifier).

query x: bitstring, y: bitstring, z: bitstring;
      event(AccessTokenIssued(x, y, z)) ==> event(UserAuthenticated(z)).

query x: bitstring, y: bitstring, z: bitstring;
      event(AccessTokenIssued(x, y, z)) ==> event(ClientSentTokenRequest(x)).

query x: bitstring, y: bitstring, z: bitstring;
      inj-event(AccessTokenIssued(x, y, z)) ==> inj-event(AuthCodeIssued(x)).

query x: bitstring, y: bitstring, z: bitstring;
      event(AccessTokenIssued(x, y, z)) ==> event(PKCEChallengeVerified(x)).

query x: bitstring, y: bitstring, z: bitstring;
      event(AccessTokenIssued(x, y, z)) ==> event(MACVerified(x)).

(* P0 (single use): begin event at code issuance.
   One AuthCodeIssued per code; two redemptions of the same code would need
   two issuances, so a successful replay makes this query false. *)
query x: bitstring, cnt: counter;
      inj-event(CodeUsedSuccessfully(x, cnt)) ==> inj-event(AuthCodeIssued(x)).

query x: bitstring, y: bitstring, z: bitstring;
      event(AccessTokenIssued(x, y, z)) ==> event(AuthCodeBindingVerified(x, y)).

(* PL2 (reference only): begin event after the signature check.
   Begin and end are in the same server thread, so every end has its own
   begin even under replay. *)
query x: bitstring, cnt: counter;
      inj-event(CodeUsedSuccessfully(x, cnt)) ==> inj-event(CodeExchangeInitiated(x)).

query a: counter, b: counter;
      event(CounterIncremented(a, b)) ==> b = succ(a).
query a: counter;
      event(CounterUsedInOrder(succ(a))) ==> event(CounterUsedInOrder(a)).

query x: bitstring, y: bitstring, z: bitstring;
      event(AccessTokenIssued(x, y, z)) ==> event(SignatureVerified(x)).

query x: bitstring;
      event(InjectionAttemptBlocked(x)) ==> event(TamperedMessageDetected(x)).

query x: bitstring, y: bitstring, z: bitstring;
      event(AccessTokenIssued(x, y, z)) ==> event(AuthCodeIssued(x)).

(* ==== Q5, Q6 (earlier form: the attacker receives any response) ==== *)

(* Q5: attacker intercepts code x, and receives any response *)
query x: bitstring, y: bitstring;
      event(AttackerInterceptedAuthCode(x)) && event(AttackerReceivedResponse(y)) ==> false.

(* Q6: same, with the attacker also trying to use code x *)
query x: bitstring, y: bitstring;
      event(AttackerInterceptedAuthCode(x)) && event(AttackerAttemptedToUseCode(x))
      && event(AttackerReceivedResponse(y)) ==> false.

(* ==== Q5+, Q6+, Q16+ (checked with the real token) ==== *)

(* Q5+: attacker intercepts code x, and knows the real token issued for x *)
query x: bitstring, tok: bitstring;
      event(AttackerInterceptedAuthCode(x)) && event(TokenIssuedFor(x, tok))
      && attacker(tok) ==> false.

(* Q6+: same, with the attacker also trying to use code x *)
query x: bitstring, tok: bitstring;
      event(AttackerInterceptedAuthCode(x)) && event(AttackerAttemptedToUseCode(x))
      && event(TokenIssuedFor(x, tok)) && attacker(tok) ==> false.

(* Q16+: tampering is detected for x, and the attacker knows a real token issued for x *)
query x: bitstring, tok: bitstring;
      event(TamperedMessageDetected(x)) && event(TokenIssuedFor(x, tok))
      && attacker(tok) ==> false.

(* ==== PLACEMENT COMPARISON (PL1, PL3), REFERENCE ONLY ==== *)
(* Same reason as PL2: begin and end are in the same thread. *)

(* PL1: begin before MAC / signature verification *)
query x: bitstring, cnt: counter;
      inj-event(CodeUsedSuccessfully(x, cnt)) ==> inj-event(BeginBeforeSignature(x)).

(* PL3: begin after the used-code check *)
query x: bitstring, cnt: counter;
      inj-event(CodeUsedSuccessfully(x, cnt)) ==> inj-event(BeginAfterReplayCheck(x)).

(* Q-SU (single use): stated directly on the redemption events *)
query x: bitstring, r1: bitstring, r2: bitstring;
      event(Redeemed(x, r1)) && event(Redeemed(x, r2)) ==> r1 = r2.

(* S1 *)
query s: bitstring, x: bitstring, t: bitstring;
      event(ClientAcceptedTokenS(s, x, t)) ==> event(TokenIssuedForS(s, x, t)).
(* S2 *)
query s: bitstring, x: bitstring, t: bitstring;
      event(ClientAcceptedTokenS(s, x, t)) ==> event(AuthCodeIssuedForS(s, x)).
(* S3 *)
query s: bitstring, x: bitstring, t: bitstring;
      inj-event(ClientAcceptedTokenS(s, x, t)) ==> inj-event(TokenIssuedForS(s, x, t)).
(* S4 *)
query s: bitstring, x: bitstring, t: bitstring;
      event(ClientAcceptedTokenS(s, x, t)) ==> event(ClientStartedS(s)).

(* ==== REACHABILITY (R1-R17) ==== *)
(* R1 *)  query x: bitstring, y: bitstring, z: bitstring; event(AccessTokenIssued(x, y, z)).
(* R2 *)  query x: bitstring, cnt: counter; event(CodeUsedSuccessfully(x, cnt)).
(* R3 *)  query x: bitstring; event(PKCEChallengeVerified(x)).
(* R4 *)  query x: bitstring; event(ReplayDetectedAndBlocked(x)).
(* R5 *)  query x: bitstring; event(TamperedMessageDetected(x)).
(* R6 *)  query x: bitstring; event(ClientSentTokenRequest(x)).
(* R7 *)  query x: bitstring; event(BeginBeforeSignature(x)).
(* R8 *)  query x: bitstring; event(BeginAfterReplayCheck(x)).
(* R9 *)  query x: bitstring; event(TokenRequestSent(x)).
(* R10 *) query x: bitstring; event(AttackerInterceptedAuthCode(x)).
(* R11 *) query x: bitstring; event(AttackerAttemptedToUseCode(x)).
(* R12 *) query x: bitstring, tok: bitstring; event(TokenIssuedFor(x, tok)).
(* R13 *) query x: bitstring; event(ClientAcceptedToken(x)).
(* R14 *) query x: bitstring; event(ClientRejectedToken(x)).
(* R15 *) query x: bitstring; event(AttackerReceivedResponse(x)).
(* R16 *) query x: bitstring, r: bitstring; event(Redeemed(x, r)).
(* R17 *) query s: bitstring, x: bitstring, t: bitstring; event(ClientAcceptedTokenS(s, x, t)).

(* ==== AUTHORIZATION SERVER ==== *)

let AuthorizationServer(serverKey: bitstring, serverSigKey: bitstring, tlsKey: bitstring) =
    in(browser, (clientId: bitstring, redirectUri: bitstring, state: bitstring,
                 codeChallenge: bitstring, codeChallengeMethod: bitstring,
                 requestTime: timestamp, csid: bitstring));
    new userId: bitstring;
    event UserAuthenticated(userId);

    new authCode: bitstring;
    let sessionID = csid in

    event CounterUsedInOrder(c0);
    let nextCounter = succ(c0) in
    event CounterIncremented(c0, nextCounter);
    event CounterUsedInOrder(nextCounter);

    let authCodeData = (authCode, clientId, codeChallenge, userId,
                        requestTime, sessionID, nextCounter) in
    let authCodeSig = sign(authCodeData, serverSigKey) in
    let encryptedAuthCode = senc((authCodeData, authCodeSig), serverKey) in
    event AuthCodeIssued(encryptedAuthCode);
    event AuthCodeIssuedForS(sessionID, encryptedAuthCode);

    let authCodeMAC = mac(encryptedAuthCode, serverKey) in
    out(c, (encryptedAuthCode, authCodeMAC, state, nextCounter));

    (
        (* Token endpoint, replicated: the same code may be presented any number of times *)
        ! in(c, tokenRequestMsg: bitstring);
        let (tokenReqData: bitstring, authCodeMACReceived: bitstring) = tokenRequestMsg in
        let (grantType: bitstring, clientIdToken: bitstring, authCodeReceived: bitstring,
             redirectUriToken: bitstring, encryptedCodeVerifier: bitstring,
             tokenRequestTime: timestamp, requestCounter: counter) = tokenReqData in

        (* PL1 *)
        event BeginBeforeSignature(authCodeReceived);

        let macOK = verify_mac(authCodeMACReceived, authCodeReceived, serverKey) in
        (
            event MACVerified(authCodeReceived);
            let (authCodeContent: bitstring, authCodeSigReceived: bitstring) =
                sdec(authCodeReceived, serverKey) in
            let (originalAuthCode: bitstring, originalClientId: bitstring,
                 originalChallenge: bitstring, originalUserId: bitstring,
                 originalTimestamp: timestamp, originalSessionID: bitstring,
                 originalCounter: counter) = verify(authCodeSigReceived, pk(serverSigKey)) in
            event SignatureVerified(authCodeReceived);

            if originalAuthCode = authCode then
            (* PL2 *)
            event CodeExchangeInitiated(authCodeReceived);

            if grantType = GRANT_TYPE_AUTH_CODE then
            if clientIdToken = originalClientId then
            if requestCounter = originalCounter then

            (* Used-code check: lookup and record (before PKCE in this earlier model) *)
            get UsedAuthCodes(=originalAuthCode, =originalCounter, =originalSessionID) in
            (
                event ReplayDetectedAndBlocked(authCodeReceived);
                out(c, INVALID_GRANT)
            )
            else
            new sid: bitstring;
            event Stored(originalAuthCode, sid);
            insert UsedAuthCodes(originalAuthCode, originalCounter, originalSessionID);

            (* PL3 *)
            event BeginAfterReplayCheck(authCodeReceived);

            event CounterValidated(authCodeReceived, requestCounter);

            let (boundCode: bitstring, codeVerifier: bitstring, reqSid: bitstring) =
                sdec(encryptedCodeVerifier, tlsKey) in
            if boundCode = authCodeReceived then
            if reqSid = originalSessionID then   (* session identifier check *)
            if s256(codeVerifier) = originalChallenge then   (* PKCE check *)
            (
                event PKCEChallengeVerified(authCodeReceived);
                event CodeUsedSuccessfully(authCodeReceived, requestCounter);
                event AuthCodeBindingVerified(authCodeReceived, originalClientId);
                new accessToken: bitstring;
                event Redeemed(authCodeReceived, accessToken);
                event AccessTokenIssued(authCodeReceived, clientIdToken, originalUserId);
                event TokenIssuedFor(authCodeReceived, accessToken);
                event TokenIssuedForS(originalSessionID, authCodeReceived, accessToken);
                (* Token response, tagged and bound to the code and session *)
                out(c, senc((TOKEN_RESPONSE, authCodeReceived, originalSessionID, accessToken), tlsKey))
            )
            else
                out(c, INVALID_GRANT)
        )
        else
        (
            event TamperedMessageDetected(authCodeReceived);
            event InjectionAttemptBlocked(authCodeReceived);
            out(c, INVALID_REQUEST)
        )
    ).

(* ==== LEGITIMATE CLIENT ==== *)

let LegitimateClient(clientId: bitstring, redirectUri: bitstring, tlsKey: bitstring) =
    new codeVerifier: bitstring;
    let codeChallenge = s256(codeVerifier) in
    new state: bitstring;
    new csid: bitstring;
    event ClientStartedS(csid);
    out(c, csid);
    out(browser, (clientId, redirectUri, state, codeChallenge,
                  CODE_CHALLENGE_METHOD_S256, t0, csid));
    in(c, (authCode: bitstring, authCodeMAC: bitstring,
           stateReceived: bitstring, receivedCounter: counter));
    if stateReceived = state then
    let encryptedCodeVerifier = senc((authCode, codeVerifier, csid), tlsKey) in
    let tokenReqData = (GRANT_TYPE_AUTH_CODE, clientId, authCode,
                        redirectUri, encryptedCodeVerifier, t1, receivedCounter) in
    event ClientSentTokenRequest(authCode);
    event TokenRequestSent(authCode);
    out(c, (tokenReqData, authCodeMAC));
    in(c, tokenResponse: bitstring);
    event ClientReceivedTokenResponse(authCode);
    (* Accept only a tagged token response for this code and this session *)
    let (=TOKEN_RESPONSE, =authCode, =csid, receivedToken: bitstring) =   (* own session only *)
        sdec(tokenResponse, tlsKey) in
    (
        event ClientAcceptedToken(authCode);
        event ClientAcceptedTokenS(csid, authCode, receivedToken)
    )
    else
    (
        event ClientRejectedToken(authCode)
    ).

(* ==== MALICIOUS CLIENT ==== *)
(* No state check. Sends any request the attacker chooses. *)

let MaliciousClient() =
    in(c, (interceptedCode: bitstring, interceptedMAC: bitstring,
           interceptedState: bitstring, interceptedCounter: counter));
    event AttackerInterceptedAuthCode(interceptedCode);
    in(c, (anyReqData: bitstring, anyReqMAC: bitstring));
    let (g: bitstring, cid: bitstring, usedCode: bitstring, ruri: bitstring,
         ver: bitstring, tReq: timestamp, cntReq: counter) = anyReqData in
    event AttackerAttemptedToUseCode(usedCode);
    event TokenRequestSent(usedCode);
    out(c, (anyReqData, anyReqMAC));
    (* Any response, used by the earlier form of Q5 and Q6 *)
    in(c, response: bitstring);
    event AttackerReceivedResponse(response).

(* ==== MAIN PROCESS ==== *)

process
    new serverKey: bitstring;
    new serverSigKey: bitstring;
    new tlsKey: bitstring;
    new legitimateClientId: bitstring;
    new redirectUri: bitstring;
    (
        !AuthorizationServer(serverKey, serverSigKey, tlsKey)
      | !LegitimateClient(legitimateClientId, redirectUri, tlsKey)
      | !MaliciousClient()
    )